<div class="row">
  <div class="col-sm-2 abbr">
    {% if entry.abbr %}
      <abbr class="badge">{{ entry.abbr }}</abbr>
    {% endif %}
  </div>

  <div id="{{ entry.key }}" class="col-sm-8">
    <div class="title">
      {% if entry.doi %}
        <a href="https://doi.org/{{ entry.doi }}" target="_blank" rel="noopener noreferrer">
          {{ entry.title }}
        </a>
      {% else %}
        {{ entry.title }}
      {% endif %}
    </div>

    <div class="author">
      {{ entry.author }}
    </div>

    <div class="periodical">
      {% if entry.year %}
        {{ entry.year }}
      {% endif %}
      {% if entry.journal %}
        <em>{{ entry.journal }}</em>
      {% elsif entry.booktitle %}
        <em>{{ entry.booktitle }}</em>
      {% endif %}
    </div>
  </div>
</div>

